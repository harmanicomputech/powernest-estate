APP_NAME="PowerNest Estate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 / MariaDB 10.6+ in production. SQLite works for local development.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=powernest_estate
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Integrations. Never commit real values. See docs/DEPLOYMENT.md.
# INTEGRATIONS_LIVE=false blocks every outbound provider request
# (payments + vending). Set to true only on the production server.
# ---------------------------------------------------------------
INTEGRATIONS_LIVE=false

# Stron prepaid vending
STRON_BASE_URL=
STRON_COMPANY=
STRON_USERNAME=
STRON_PASSWORD=
STRON_TIMEOUT=45

# Paystack
PAYSTACK_ENABLED=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Payaza
PAYAZA_ENABLED=false
PAYAZA_PUBLIC_KEY=
PAYAZA_SECRET_KEY=
# test | live
PAYAZA_ENVIRONMENT=test
# Transaction status query endpoint. {reference} is substituted. Confirm against Payaza docs before go-live.
PAYAZA_VERIFY_URL=
# Random string appended to the webhook URL registered in the Payaza dashboard: /webhooks/payaza/{secret}
PAYAZA_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
